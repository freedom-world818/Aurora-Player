# =============================================================================
#  Cloudflare Pages Redirects / Rewrites
#  单页应用 SPA 兜底：任何未匹配到静态文件的路径回退到 index.html
#  API 路径不回退，交给 Pages Functions（functions/api.js）处理
# =============================================================================

# 让 /api/* 直接走 Pages Functions（显式声明，避免被 SPA 回退兜底吃掉）
/api/*  /api/:splat  200

# SPA 兜底：所有未命中静态文件的请求回退到 index.html（200 重写，不是 302 跳转）
/*  /index.html  200
